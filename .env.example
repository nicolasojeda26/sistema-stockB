# Conexión a Postgres. En Supabase: Project Settings > Database > Connection string,
# modo "Transaction pooler" (puerto 6543) para Vercel.
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# (Con la integración de Supabase en Vercel alcanza con POSTGRES_URL, que la carga la integración.)

# Clave para firmar las sesiones: al menos 32 caracteres al azar.
# Opcional: si falta, el sistema genera una y la guarda en la base (tabla secretos).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Clave para cifrar en la base la clave privada del certificado de ARCA (al menos 32 caracteres).
# No la cambies después de generar el certificado: habría que generar uno nuevo.
CLAVE_CIFRADO=
